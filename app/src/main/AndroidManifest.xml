<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hanvon.clear6.pomodoro">

    <!-- 核心权限声明：汉王 Clear6 及通用墨水屏电纸书 (Android 8.0 ~ 14) 专用 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 硬件级精确闹钟唤醒权限：即使进程被汉王系统强杀，到点仍由系统内核准时唤醒弹出小猫 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 免悬浮窗权限全屏透明跳出权限（无需开启被汉王禁用的「显示在其他应用上层」） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 严禁声明 INTERNET 权限，确保 100% 纯离线运行、不依赖谷歌服务 -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_pomodoro_eink"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clear6Pomodoro.EInk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 免悬浮窗权限的 100% 全透明黑猫霸屏 Activity：独立 Task 栈直接浮在《微信读书》书页上方 -->
        <activity
            android:name=".RestCatOverlayActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.hanvon.clear6.pomodoro.catoverlay"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Clear6Pomodoro.TranslucentOverlay" />

        <service
            android:name=".PomodoroForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <receiver
            android:name=".BootAndUnlockReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="com.hanvon.clear6.pomodoro.ACTION_ALARM_PHASE_EXPIRED" />
                <action android:name="com.hanvon.clear6.pomodoro.ACTION_KEEPALIVE_RESTART" />
            </intent-filter>
        </receiver>

    </application>
</manifest>