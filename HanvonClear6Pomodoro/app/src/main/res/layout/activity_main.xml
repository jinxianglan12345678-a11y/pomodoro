<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="墨茄番茄钟 v1.0"
            android:textColor="#000000"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitleRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="工作15分 → 休息5分 循环 · 锁屏立即清零 · 解锁自动重开"
            android:textColor="#000000"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000" />

    <!-- 当前阶段状态横幅 -->
    <TextView
        android:id="@+id/tvPhaseBanner"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="#000000"
        android:gravity="center"
        android:text="当前阶段：专注工作（15 分钟）"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 中央舞台区：工作时显示超大倒计时，休息时出现趴着摇尾巴的线性大猫挡住屏幕 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 工作阶段：超大倒计时显示区 -->
        <LinearLayout
            android:id="@+id/layoutWorkTimerStage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTimerDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="15"
                android:textColor="#000000"
                android:textSize="112sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimerUnitHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="分钟剩余 · 墨水屏按分刷新模式"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="屏幕常亮保持中"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 休息阶段：趴着摇尾巴的线性大猫挡住屏幕中央 -->
        <com.hanvon.clear6.pomodoro.RestingCatEInkView
            android:id="@+id/restingCatView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 手动控制主按钮组 -->
    <Button
        android:id="@+id/btnStartPause"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#000000"
        android:stateListAnimator="@null"
        android:text="暂停计时"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSkipPhase"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:stateListAnimator="@null"
            android:text="跳过阶段"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:stateListAnimator="@null"
            android:text="重置(15分)"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:stateListAnimator="@null"
            android:text="时长与设置 ▼"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 默认隐藏的「时长自定义与规则设置」折叠抽屉 (android:visibility="gone") -->
    <LinearLayout
        android:id="@+id/layoutSettingsDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnCycleDurationPreset"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#FFFFFF"
            android:stateListAnimator="@null"
            android:text="预设切换：工作15分 / 休息5分 (点此切换)"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWorkMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:stateListAnimator="@null"
                android:text="工作 -5分"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWorkPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:stateListAnimator="@null"
                android:text="工作 +5分"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:stateListAnimator="@null"
                android:text="休息 -1分"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:stateListAnimator="@null"
                android:text="休息 +1分"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleLockRule"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="#FFFFFF"
            android:stateListAnimator="@null"
            android:text="锁屏规则：锁屏立即清零 · 解锁自动重开"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleLockscreenNotif"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="#FFFFFF"
            android:stateListAnimator="@null"
            android:text="锁屏通知提示：已开启（锁屏实时显示剩余时长）"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCycleSoundPreset"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="#FFFFFF"
            android:stateListAnimator="@null"
            android:text="提醒音效：清脆嘀嗒 (点此切换/试听)"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbHighSpeedMode"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:buttonTint="#000000"
                android:text="高速刷新(显秒)"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbMinuteTick"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:buttonTint="#000000"
                android:text="整分微弱嘀嗒声"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBatteryWhitelist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:stateListAnimator="@null"
                android:text="1.电池白名单"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNotificationSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:stateListAnimator="@null"
                android:text="2.通知栏权限"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAutoStartSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:stateListAnimator="@null"
                android:text="3.自启动权限"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="#000000" />

    <!-- 番茄统计栏 -->
    <TextView
        android:id="@+id/tvStatsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="今日完成番茄：0 个   |   历史累计：0 个"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 开发者专属署名与版本信息栏 -->
    <TextView
        android:id="@+id/tvDeveloperSignature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="开发与维护：@墨茄popo   |   反馈与更新：QQ 1125041786   |   版本 v1.0"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>